APP_NAME := canloader_test_app
BUILD_DIR := build/stm32g0b1re
PROJECT_ROOT := ..

STM32_GNU_BIN ?= $(firstword \
	$(wildcard $(HOME)/apps/stm32cubeide/plugins/com.st.stm32cube.ide.mcu.externaltools.gnu-tools-for-stm32.*/tools/bin) \
	$(wildcard /Applications/STM32CubeIDE.app/Contents/Eclipse/plugins/com.st.stm32cube.ide.mcu.externaltools.gnu-tools-for-stm32.*/tools/bin))
TOOLCHAIN ?= $(if $(STM32_GNU_BIN),$(STM32_GNU_BIN)/arm-none-eabi-,arm-none-eabi-)
CC := $(TOOLCHAIN)gcc
OBJCOPY := $(TOOLCHAIN)objcopy
SIZE := $(TOOLCHAIN)size

CPU_FLAGS := -mcpu=cortex-m0plus -mthumb -mfloat-abi=soft
DEFINES := \
	-DSTM32G0B1xx \
	-DUSE_HAL_DRIVER \
	-DBOOT_TARGET_STM32G0B1RE \
	-DUSER_VECT_TAB_ADDRESS \
	-DVECT_TAB_OFFSET=0x00008000U
INCLUDES := \
	-I$(PROJECT_ROOT)/Application/Inc \
	-I$(PROJECT_ROOT)/Config \
	-I$(PROJECT_ROOT)/Portable/Inc \
	-I$(PROJECT_ROOT)/Protocol/Inc \
	-I$(PROJECT_ROOT)/Targets/stm32g0b1re/Core/Inc \
	-I$(PROJECT_ROOT)/Drivers/STM32G0xx_HAL_Driver/Inc \
	-I$(PROJECT_ROOT)/Drivers/STM32G0xx_HAL_Driver/Inc/Legacy \
	-I$(PROJECT_ROOT)/Drivers/CMSIS/Include \
	-I$(PROJECT_ROOT)/Drivers/CMSIS/Device/ST/STM32G0xx/Include

CFLAGS := $(CPU_FLAGS) -std=c11 -Os -g3 \
	-ffreestanding -fno-builtin -ffunction-sections -fdata-sections \
	-Wall -Wextra -Werror -MMD -MP
ASFLAGS := $(CPU_FLAGS) -x assembler-with-cpp -MMD -MP
LDFLAGS := $(CPU_FLAGS) -nostdlib -Tlinker_stm32g0b1re.ld \
	-Wl,--gc-sections -Wl,--cref -Wl,--print-memory-usage \
	-Wl,-Map=$(BUILD_DIR)/$(APP_NAME).map
LDLIBS := -lgcc

C_SOURCES := \
	Src/main_stm32g0.c \
	$(PROJECT_ROOT)/Targets/stm32g0b1re/Core/system_stm32g0xx.c \
	$(PROJECT_ROOT)/Targets/stm32g0b1re/Core/stm32g0xx_hal_msp.c \
	$(PROJECT_ROOT)/Application/Src/boot_device_config.c \
	$(PROJECT_ROOT)/Application/Src/boot_metadata.c \
	$(PROJECT_ROOT)/Protocol/Src/boot_crc32.c \
	$(PROJECT_ROOT)/Protocol/Src/boot_j1939.c \
	$(PROJECT_ROOT)/Protocol/Src/boot_j1939_address_claim.c \
	$(PROJECT_ROOT)/Protocol/Src/boot_j1939_tp.c \
	$(PROJECT_ROOT)/Protocol/Src/boot_protocol.c \
	$(PROJECT_ROOT)/Portable/stm32g0/Src/boot_can_stm32g0.c \
	$(PROJECT_ROOT)/Portable/stm32g0/Src/boot_flash_stm32g0.c \
	$(PROJECT_ROOT)/Portable/stm32g0/Src/boot_platform_stm32g0.c \
	$(PROJECT_ROOT)/Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal.c \
	$(PROJECT_ROOT)/Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_cortex.c \
	$(PROJECT_ROOT)/Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_fdcan.c \
	$(PROJECT_ROOT)/Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c \
	$(PROJECT_ROOT)/Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash_ex.c \
	$(PROJECT_ROOT)/Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_gpio.c \
	$(PROJECT_ROOT)/Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_pwr.c \
	$(PROJECT_ROOT)/Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_pwr_ex.c \
	$(PROJECT_ROOT)/Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_rcc.c \
	$(PROJECT_ROOT)/Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_rcc_ex.c
ASM_SOURCE := $(PROJECT_ROOT)/Targets/stm32g0b1re/Core/Startup/startup_stm32g0b1xx.s

VPATH := $(sort $(dir $(C_SOURCES) $(ASM_SOURCE)))
OBJECTS := $(addprefix $(BUILD_DIR)/,$(notdir $(C_SOURCES:.c=.o))) \
	$(BUILD_DIR)/startup_stm32g0b1xx.o
DEPS := $(OBJECTS:.o=.d)

ELF := $(BUILD_DIR)/$(APP_NAME).elf
BIN := $(BUILD_DIR)/$(APP_NAME).bin
HEX := $(BUILD_DIR)/$(APP_NAME).hex

.PHONY: all clean

all: $(BIN) $(HEX)
	$(SIZE) $(ELF)

$(ELF): $(OBJECTS) linker_stm32g0b1re.ld | $(BUILD_DIR)
	$(CC) $(LDFLAGS) $(OBJECTS) $(LDLIBS) -o $@

$(BIN): $(ELF)
	$(OBJCOPY) -O binary $< $@

$(HEX): $(ELF)
	$(OBJCOPY) -O ihex $< $@

$(BUILD_DIR)/%.o: %.c Makefile.stm32g0b1re | $(BUILD_DIR)
	$(CC) $(DEFINES) $(INCLUDES) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/%.o: %.s Makefile.stm32g0b1re | $(BUILD_DIR)
	$(CC) $(DEFINES) $(INCLUDES) $(ASFLAGS) -c $< -o $@

$(BUILD_DIR):
	mkdir -p $@

clean:
	$(RM) -r -- $(BUILD_DIR)

-include $(DEPS)
